{
  "name": "tri-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:env": "node tools/init-dev-env.mjs",
    "dev:settings-key": "node tools/init-settings-key.mjs",
    "dev:open-key": "node tools/init-open-key.mjs",
    "test:tools": "node --test tools/tests/*.test.mjs",
    "test:desktop": "npm --workspace @tri-admin/desktop test",
    "test": "npm run test:tools && npm run test:desktop",
    "dev:desktop": "npm --workspace @tri-admin/desktop run dev",
    "desktop": "npm --workspace @tri-admin/desktop run tauri -- dev",
    "build:desktop": "npm --workspace @tri-admin/desktop run tauri -- build",
    "test:e2e": "playwright test",
    "test:s3": "node tools/test-s3-all.mjs",
    "format": "prettier --write apps/desktop/src apps/desktop/vite.config.ts tests/e2e playwright.config.ts package.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3"
  }
}
